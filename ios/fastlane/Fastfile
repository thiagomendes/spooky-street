# Signs the Unity-exported Xcode project and uploads it to App Store Connect for TestFlight.
# Invoked only by .github/workflows/ios-testflight.yml on a GitHub-hosted macOS runner.
# Never submits for review or external testing, and never releases publicly.
#
# Required environment (from the protected "testflight" GitHub environment):
#   SSS_XCODE_DIR           extracted Unity export containing Unity-iPhone.xcodeproj
#   SSS_BUNDLE_ID           bundle identifier registered in the Apple Developer account
#   SSS_BUILD_NUMBER        unique CFBundleVersion for this attempt, e.g. "57.1"
#   SSS_CERT_PATH           Apple Distribution certificate (.p12) written to RUNNER_TEMP
#   IOS_DIST_CERT_PASSWORD  password of that .p12
#   SSS_PROFILE_PATH        App Store provisioning profile written to RUNNER_TEMP
#   APPLE_TEAM_ID           10-character team identifier
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8_BASE64   App Store Connect API key (App Manager role)
#   SSS_OUTPUT_DIR          where the .ipa and logs are written

default_platform(:ios)

def require_env(name)
  value = ENV[name].to_s
  UI.user_error!("Missing required environment variable #{name}") if value.empty?
  value
end

platform :ios do
  lane :ci_testflight do
    xcode_dir = require_env("SSS_XCODE_DIR")
    project = File.join(xcode_dir, "Unity-iPhone.xcodeproj")
    bundle_id = require_env("SSS_BUNDLE_ID")
    build_number = require_env("SSS_BUILD_NUMBER")
    team_id = require_env("APPLE_TEAM_ID")
    output_dir = require_env("SSS_OUTPUT_DIR")
    profile_path = require_env("SSS_PROFILE_PATH")

    # Temporary keychain that the runner discards with the VM.
    setup_ci(force: true)

    api_key = app_store_connect_api_key(
      key_id: require_env("ASC_KEY_ID"),
      issuer_id: require_env("ASC_ISSUER_ID"),
      key_content: require_env("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      duration: 1200,
      in_house: false
    )

    import_certificate(
      certificate_path: require_env("SSS_CERT_PATH"),
      certificate_password: require_env("IOS_DIST_CERT_PASSWORD"),
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: "",
      log_output: false
    )

    install_provisioning_profile(path: profile_path)
    profile_name = FastlaneCore::ProvisioningProfile.name(profile_path)
    UI.message("Using provisioning profile '#{profile_name}'")

    # Only the app target carries the profile; UnityFramework is signed with the same identity
    # when it is embedded.
    update_code_signing_settings(
      path: project,
      use_automatic_signing: false,
      targets: ["Unity-iPhone"],
      team_id: team_id,
      bundle_identifier: bundle_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )
    update_code_signing_settings(
      path: project,
      use_automatic_signing: false,
      targets: ["UnityFramework"],
      team_id: team_id,
      code_sign_identity: "Apple Distribution"
    )

    plist = File.join(xcode_dir, "Info.plist")
    set_info_plist_value(path: plist, key: "CFBundleVersion", value: build_number)
    # The game makes no network requests in S000 and uses no non-exempt encryption.
    set_info_plist_value(path: plist, key: "ITSAppUsesNonExemptEncryption", value: false)

    ipa = build_app(
      project: project,
      scheme: "Unity-iPhone",
      configuration: "Release",
      export_method: "app-store",
      export_team_id: team_id,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { bundle_id => profile_name },
        manageAppVersionAndBuildNumber: false,
        uploadSymbols: true
      },
      output_directory: output_dir,
      output_name: "SpookyStreet-#{build_number}.ipa",
      buildlog_path: File.join(output_dir, "xcodebuild-logs"),
      include_symbols: true,
      skip_profile_detection: true
    )

    # Upload only. Processing is polled by a cheap Linux job so macOS minutes are not spent waiting.
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false
    )

    File.write(File.join(output_dir, "upload.json"),
               JSON.pretty_generate(bundle_id: bundle_id, build_number: build_number, ipa: File.basename(ipa)))
  end
end
