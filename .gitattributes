# Text assets: Unity serializes as YAML text (Force Text). Normalize line endings.
* text=auto eol=lf
*.cs text diff=csharp
*.unity text merge=unityyamlmerge eol=lf
*.prefab text merge=unityyamlmerge eol=lf
*.asset text merge=unityyamlmerge eol=lf
*.mat text merge=unityyamlmerge eol=lf
*.meta text eol=lf
*.sh text eol=lf

# Large source binaries go through Git LFS (patterns reserved). Fonts (<1 MB each) are plain binaries.
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.FBX filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ttf binary
*.otf binary
*.aif filter=lfs diff=lfs merge=lfs -text

# Small review captures stay in plain git (no LFS bandwidth for CI checkouts).
docs/evidence/** -filter -diff -merge binary

# Original game models and their baked textures stay in plain git (LFS is unreachable from cloud sessions).
Assets/SpookyStreet/Content/Resources/Models/** -filter -diff -merge binary
Assets/SpookyStreet/Content/Resources/UI/** -filter -diff -merge binary
# Approved sound effects (S003, D20.1): WAV masters and the Ogg night bed, also in plain git.
Assets/SpookyStreet/Content/Resources/Audio/** -filter -diff -merge binary

# Generated audio sources (Gemini TTS FLAC, Lyria MP3) kept for reproducibility in plain git (D20.1).
tools/audio/generated/** -filter -diff -merge binary
tools/audio/generated/*.json text eol=lf -binary diff
tools/audio/generated/*.jsonl text eol=lf -binary diff
tools/audio/generated/review/*.json text eol=lf -binary diff
