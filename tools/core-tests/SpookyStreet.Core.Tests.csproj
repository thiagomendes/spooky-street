<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compiles the NUnit tests for the engine-free SpookyStreet.Core (built by ../core-lib) outside Unity, so cloud
    sessions and CI can run them without a Unity licence. Unity compiles the same files through the
    SpookyStreet.Core and SpookyStreet.Tests.EditMode assemblies.
    LangVersion 9.0 matches Unity 6's C# compiler; keep Core free of newer syntax.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>SpookyStreet.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/SpookyStreet/Tests/EditMode/Core/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Core is a separate assembly, as in Unity: tests only see its public surface. -->
    <ProjectReference Include="../core-lib/SpookyStreet.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
